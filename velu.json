{
  "$schema": "https://veludocs.com/velu.schema.json",
  "name": "Velu",
  "colors": {
    "primary": "#dc143c"
  },
  "favicon": "/favicon.svg",
  "font": {
    "family": "Google Sans Flex"
  },
  "navbar": {
    "links": [
      { "label": "Dashboard", "href": "https://docs.getvelu.com", "icon": "layout-dashboard" }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://docs.getvelu.com/signup"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Dashboard", "href": "https://docs.getvelu.com" },
          { "label": "Quickstart", "href": "/docs/quickstart" },
          { "label": "Changelog", "href": "/docs/changelog" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Components", "href": "/docs/components/overview" },
          { "label": "Deploy", "href": "/docs/deploy/publishing" }
        ]
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "installation",
              "development"
            ]
          },
          {
            "group": "Configuration",
            "icon": "sliders-horizontal",
            "pages": [
              "configuration/settings",
              "configuration/navigation",
              "configuration/themes",
              "configuration/seo"
            ]
          },
          {
            "group": "Writing content",
            "icon": "pen-line",
            "pages": [
              "writing/pages",
              "writing/page-modes",
              "writing/writing-with-ai",
              "writing/markdown",
              "writing/code",
              "writing/images"
            ]
          },
          {
            "group": "Components",
            "icon": "component",
            "pages": [
              "components/overview",
              "components/callouts",
              "components/cards",
              "components/columns",
              "components/accordions",
              "components/steps",
              "components/code-groups",
              "components/tree",
              "components/fields",
              "components/prompts",
              "components/icons",
              "components/changelog"
            ]
          },
          {
            "group": "AI & optimization",
            "icon": "sparkles",
            "pages": [
              "ai/markdown-export",
              "ai/skill-md",
              "ai/model-context-protocol",
              "ai/ask-ai",
              "ai/contextual-menu",
              "ai/search"
            ]
          },
          {
            "group": "Deploy",
            "icon": "cloud-upload",
            "pages": [
              "deploy/publishing",
              "deploy/custom-domains"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "megaphone",
        "pages": ["changelog"]
      }
    ]
  }
}
